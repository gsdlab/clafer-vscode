{
  "name": "clafer-syntax",
  "displayName": "Clafer",
  "description": "Clafer modeling language: syntax highlighting, snippets, a language server (errors as you type, outline, go to definition, references, hover, completion, rename), compilation, and instance generation",
  "version": "0.6.0",
  "publisher": "gsdlab",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/gsdlab/clafer-vscode"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:clafer"
  ],
  "scripts": {
    "test": "node --test test/compile.mjs test/server.mjs && node test/grammar.mjs"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "contributes": {
    "languages": [
      {
        "id": "clafer",
        "aliases": [
          "Clafer",
          "clafer"
        ],
        "extensions": [
          ".cfr"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file-icon.png",
          "dark": "./images/file-icon.png"
        }
      }
    ],
    "snippets": [
      {
        "language": "clafer",
        "path": "./snippets/clafer.json"
      }
    ],
    "grammars": [
      {
        "language": "clafer",
        "scopeName": "source.clafer",
        "path": "./syntaxes/clafer.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.choco": "javascript"
        }
      },
      {
        "scopeName": "markdown.clafer.codeblock",
        "path": "./syntaxes/clafer.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.clafer": "clafer"
        }
      }
    ],
    "commands": [
      {
        "command": "clafer.compile",
        "title": "Compile",
        "category": "Clafer"
      },
      {
        "command": "clafer.validate",
        "title": "Compile and Validate",
        "category": "Clafer"
      },
      {
        "command": "clafer.instancesAlloy",
        "title": "Instances (Alloy)",
        "category": "Clafer"
      },
      {
        "command": "clafer.instancesChoco",
        "title": "Instances (Choco)",
        "category": "Clafer"
      },
      {
        "command": "clafer.restartServer",
        "title": "Restart Language Server",
        "category": "Clafer"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "clafer.compile",
          "when": "editorLangId == clafer"
        },
        {
          "command": "clafer.validate",
          "when": "editorLangId == clafer"
        },
        {
          "command": "clafer.instancesAlloy",
          "when": "editorLangId == clafer"
        },
        {
          "command": "clafer.instancesChoco",
          "when": "editorLangId == clafer"
        },
        {
          "command": "clafer.restartServer",
          "when": "editorLangId == clafer"
        }
      ]
    },
    "configuration": {
      "title": "Clafer",
      "properties": {
        "clafer.toolsPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "The folder of the Clafer tools (`clafer`, `claferIG`, `chocosolver.jar`, `clafer-ls.jar`, `alloy6.2.0.jar`), e.g., an unpacked binary distribution. Empty: use the tools on `PATH`."
        },
        "clafer.languageServer": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Run the Clafer language server (`clafer-ls.jar`, with `java`), which checks the models as they are edited and gives their outline, definitions, references, hovers, completion and renaming. Off, or when the server is not found: the errors are those of the compiler when a model is saved, and the outline is by the layout of a model."
        },
        "clafer.languageServerJavaArguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "The arguments of `java` for the language server, before `-jar`, e.g., `[\"-Xmx1g\"]`."
        },
        "clafer.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-m",
            "alloy",
            "-m",
            "choco",
            "-m",
            "html",
            "--self-contained",
            "-m",
            "clafer"
          ],
          "markdownDescription": "The arguments of `clafer` for compilation; the model is added at the end. **Compile and Validate** also passes `--validate` and `--tooldir`."
        },
        "clafer.claferIGArguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "--diff",
            "--addtypes"
          ],
          "markdownDescription": "The arguments of `claferIG` for **Clafer: Instances (Alloy)**; the model is added at the end. By default, `--diff` shows each next instance, or state of a trace, as its changes, and `--addtypes` shows the types of the clafers, e.g., `A : P`."
        },
        "clafer.compileOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Compile a Clafer model when it is saved. Without the language server, also show the compiler's errors."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "~10.1.2"
  },
  "overrides": {
    "minimatch": "^11.0.9"
  }
}
